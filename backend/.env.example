# ========================================
# SmartWalk Environment Example
#
# This file shows which environment variables
# are required to run the SmartWalk backend.

# Copy this file to .env and replace the
# example values with your real configuration.
# ========================================





# Backend server port
PORT=3000

# AI URL: Python FastAPI AI service
AI_SERVICE_URL=http://localhost:8000

# Frontend URL: allowed to access the backend
FRONTEND_URL=http://localhost:5173

# ====================


# MongoDB Atlas connection
MONGO_URI=YOUR_REAL_MONGODB_URI

# Cloudinary configuration 
CLOUDINARY_CLOUD_NAME=YOUR_REAL_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_REAL_API_KEY
CLOUDINARY_API_SECRET=YOUR_REAL_API_SECRET


# ====================

# Secret key: used to create and verify JWT tokens
JWT_SECRET= ---

# API key: used to protect AI and sensor requests
SENSOR_API_KEY= ---


