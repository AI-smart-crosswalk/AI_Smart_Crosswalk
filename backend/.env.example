# PROVENANCE: [RACHE] your template. [LIEL] added AI_SERVICE_URL (AI service is now wired via /api/detect).
# ============================================================
# SANDBOX FILE - SETTLED base.
# ============================================================

# Copy to .env and fill in real values (.env is gitignored)
PORT=3000
MONGO_URI=your_mongodb_atlas_connection_string

# Cloudinary (free account at https://cloudinary.com) - Dashboard shows these
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Auth - used to sign login tokens
JWT_SECRET=your_long_random_secret

# AI service (FastAPI, ai-service/app.py). Backend calls it for POST /api/detect
AI_SERVICE_URL=http://localhost:8000

# Sensor / AI service auth: sent as the x-api-key header on POST /api/alerts and /api/detect.
# The AI service reads the same value (env var SENSOR_API_KEY, or this backend/.env file).
SENSOR_API_KEY=your_long_random_sensor_key
