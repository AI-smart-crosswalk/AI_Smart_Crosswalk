# ========================================
# SmartWalk Environment Example
#
# This file shows which environment variables
# are required to run the SmartWalk backend.
# Copy this file to .env and replace the
# example values with your real configuration.
# ========================================


# Backend server port
PORT=3000


# MongoDB Atlas connection
MONGO_URI=your_mongodb_atlas_connection_string


# Cloudinary configuration for alert images
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret


# Secret key used to create and verify JWT tokens
JWT_SECRET=your_long_random_secret


# Python FastAPI AI service
AI_SERVICE_URL=http://localhost:8000


# API key used to protect sensor and AI requests
SENSOR_API_KEY=your_long_random_sensor_key


# Frontend URL allowed to access the backend
FRONTEND_URL=http://localhost:5173